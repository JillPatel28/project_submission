{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Auth Schema",
  "description": "Authentication and authorization: roles, permissions, route protection",
  "type": "object",
  "properties": {
    "strategy": { "type": "string" },
    "tokenExpiry": { "type": "string" },
    "refreshTokenExpiry": { "type": "string" },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "permissions": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name", "permissions"]
      },
      "minItems": 1
    },
    "protectedRoutes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern": { "type": "string" },
          "roles": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["pattern", "roles"]
      }
    },
    "publicRoutes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["strategy", "roles"]
}
