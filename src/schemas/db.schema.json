{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Database Schema",
  "description": "Database configuration: tables, columns, relations, and indexes",
  "type": "object",
  "properties": {
    "dialect": { "type": "string" },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "primaryKey": { "type": "boolean" },
                "unique": { "type": "boolean" },
                "nullable": { "type": "boolean" },
                "default": {},
                "foreignKey": { "type": "object" }
              },
              "required": ["name", "type"]
            },
            "minItems": 1
          },
          "indexes": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["name", "columns"]
      },
      "minItems": 1
    }
  },
  "required": ["tables"]
}
